# Postgres (Neon or Supabase). Use the pooled connection string on Vercel.
DATABASE_URL=postgres://user:pass@host:5432/founder_mode

# Comma-separated allowlist. First email = Stefano (role "sales"), second = co-founder ("product").
ALLOWED_EMAILS=

# Signs the session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Shared password for the sign-in page (used while Google sign-in is off).
APP_PASSWORD=
# Google OAuth client (Web application). Redirect URI: <origin>/api/auth/callback/google
# Optional: when set, Google sign-in replaces the password. With no APP_PASSWORD and no
# Google client, local dev signs you in automatically as the first allowed email.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Game master (Claude). Model defaults to claude-sonnet-5-5.
ANTHROPIC_API_KEY=
# GM_MODEL=claude-sonnet-5-5

# Integrations (Phase 1+)
ATTIO_API_KEY=
LGM_API_KEY=

# Vercel Cron sends this as a Bearer token to /api/cron/*
CRON_SECRET=
